{
  "model": "facebook/dinov3-vit7b16-pretrain-lvd1689m",
  "device": "cpu",
  "image_size": 448,
  "normal_dir": "examples/data/normal",
  "prototype_dir": "examples/data/prototypes",
  "output": "outputs/example-model.json",
  "alpha": 0.5,
  "unknown_threshold": 0.35,
  "top_k_ratio": 0.05,
  "image_score": "mtop1p",
  "type_matching": "bidirectional_patch",
  "anomaly_method": "pca",
  "knn_weight": 0.5,
  "fusion_mode": "fixed",
  "gate_temperature": 1.0,
  "memory_max_patches": 50000,
  "knn_chunk_size": 256,
  "knn_backend": "auto",
  "knn_dtype": "float32",
  "feature_layers": [-1, -3, -5, -7],
  "layer_aggregation": "mean",
  "map_postprocess": "none",
  "gaussian_sigma": 1.0
}
