{
  "model": "facebook/dinov3-vit7b16-pretrain-lvd1689m",
  "device": "cpu",
  "image_size": 448,
  "resize_mode": "direct",
  "normal_dir": "examples/data/normal",
  "output": "outputs/example-model.json",
  "image_score": "mtop1p",
  "image_top_ratio": 0.01,
  "image_fusion_stage": "patch",
  "image_spatial_weight": 0.0,
  "anomaly_method": "pca",
  "pca_residual_metric": "squared_l2",
  "knn_weight": 0.5,
  "fusion_mode": "fixed",
  "gate_temperature": 1.0,
  "memory_max_patches": 50000,
  "knn_chunk_size": 256,
  "knn_spatial_radius": -1,
  "align_training_positions": false,
  "dual_branch": false,
  "test_augmentations": [],
  "knn_backend": "auto",
  "knn_dtype": "float32",
  "feature_layers": [1, 17, 21, 23],
  "layer_aggregation": "mean",
  "layer_normalization": "none",
  "map_postprocess": "none",
  "gaussian_sigma": 1.0
}
